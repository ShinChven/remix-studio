{
  "name": "remix-studio",
  "private": true,
  "version": "1.21.1",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --exclude \"agent/**\" --exclude \"data/**\" --exclude \"dist/**\" --exclude \"dist-server/**\" --exclude \"docs/**\" --exclude \"docs-site/**\" server.ts",
    "build": "vite build && tsup server.ts --format esm --out-dir dist-server --clean --external @prisma/client",
    "start": "NODE_ENV=production node dist-server/server.js",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "i18n:check": "tsx scripts/compare-i18n.ts",
    "mcp:inspect": "npx @modelcontextprotocol/inspector --transport http --url http://localhost:3000/mcp",
    "docs:install": "npm --prefix docs-site install",
    "docs:dev": "npm --prefix docs-site run dev",
    "docs:build": "npm --prefix docs-site run build",
    "docs:preview": "npm --prefix docs-site run preview"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@aws-sdk/client-s3": "^3.1106.0",
    "@aws-sdk/lib-storage": "^3.1106.0",
    "@aws-sdk/s3-request-presigner": "^3.1106.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@google/genai": "^2.16.0",
    "@hono/node-server": "^2.1.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.0.5",
    "archiver": "^8.0.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dotenv": "^17.4.2",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "google-auth-library": "^11.0.0",
    "hono": "^4.13.1",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.30.0",
    "motion": "^13.0.0",
    "openai": "^7.4.0",
    "pg": "^8.22.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.11",
    "react-icons": "5.7.0",
    "react-image-crop": "^11.1.2",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.2",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "vite": "^8.2.1",
    "ws": "^8.21.3",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@prisma/client": "^7.9.1",
    "@types/archiver": "^8.0.0",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "@types/react-dom": "^19.2.4",
    "@types/ws": "^8.18.1",
    "@types/yauzl": "^3.4.0",
    "autoprefixer": "^10.5.4",
    "prisma": "^7.9.1",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.11",
    "typescript": "~7.0.2",
    "vite": "^8.2.1"
  }
}
