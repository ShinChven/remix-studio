# ======== Ports ========
APP_PORT=3000
APP_URL=http://localhost:3000
POSTGRES_PORT=5432
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ======== PostgreSQL (via Prisma) ========
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/remix_studio"

# S3-compatible storage (MinIO for local dev)
# Set to http://localhost:9000 when running `npm run dev` on the host machine
# Set to http://minio:9000 only when the app itself runs inside Docker Compose
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=remix-studio
S3_EXPORT_BUCKET=remix-studio-exports
AWS_REGION=us-east-1
S3_PUBLIC_ENDPOINT=
S3_EXPORT_PUBLIC_ENDPOINT=
S3_PUBLIC_CUSTOM_DOMAIN=false
S3_EXPORT_PUBLIC_CUSTOM_DOMAIN=false
S3_AUTO_CREATE_BUCKET=true

# ======== Auth ========
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=your_secure_password

# Provider Encryption Key: Must be a 64-character hex string (32 bytes).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PROVIDER_ENCRYPTION_KEY=
JWT_SECRET=your_jwt_secret_change_in_production
WEBAUTHN_ORIGIN=
WEBAUTHN_RP_ID=
WEBAUTHN_RP_NAME=Remix Studio

# ======== Google OAuth (existing user login + invite-based registration) ========
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# ======== Releases: cloud drives ========
# Google Drive reuses the Google OAuth app above. Add
# ${APP_URL}/api/auth/google-drive/callback as an authorized redirect URI.
#
# OneDrive (Microsoft Graph). Register an app at
# https://entra.microsoft.com → App registrations, add
# ${APP_URL}/api/releases/drives/onedrive/callback as a Web redirect URI, and
# grant the delegated scopes: offline_access, User.Read, Files.ReadWrite.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# "common" (any account), "organizations", "consumers", or a tenant GUID.
MICROSOFT_TENANT_ID=common
# Only needed when the callback URL differs from ${APP_URL}.
MICROSOFT_REDIRECT_URI=
#
# MEGA needs no server-side configuration — each user signs in with their own
# account from the Releases page.

# ======== Releases: storefronts ========
# Gumroad OAuth application. Redirect URI: ${APP_URL}/api/stores/gumroad/callback
GUMROAD_CLIENT_ID=
GUMROAD_CLIENT_SECRET=
GUMROAD_SCOPE=edit_products view_profile view_sales

# ======== X OAuth 2.0 (For Social Media Campaigns) ========
X_CLIENT_ID=
X_CLIENT_SECRET=

# ======== Threads (Meta) OAuth (For Social Media Campaigns) ========
# Create a Meta app with the Threads use case. Redirect URL: ${APP_URL}/api/social/threads/callback
# See docs/THREADS_PLATFORM_SETUP.md
THREADS_APP_ID=
THREADS_APP_SECRET=
